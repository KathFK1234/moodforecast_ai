# Weather API (Open-Meteo - free, open source, no API key required)
# Override only if you self-host Open-Meteo
# WEATHER_API_URL=https://api.open-meteo.com/v1

# Database Configuration
DATABASE_URL=sqlite:///./moodforecast.db

# Optional: Redis Cache (if not set, uses in-memory cache)
# REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Environment
ENVIRONMENT=development
