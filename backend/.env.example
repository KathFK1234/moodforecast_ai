# Weather API (Open-Meteo - free, open source, no API key required)
# Override only if you self-host Open-Meteo
# WEATHER_API_URL=https://api.open-meteo.com/v1
# MARINE_API_URL=https://marine-api.open-meteo.com/v1

# Database Configuration
DATABASE_URL=sqlite:///./moodforecast.db

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Log every SQL statement with its values, including addresses and tokens (local debugging only)
# SQL_ECHO=true

# Email - needed for confirmation emails and daily alerts. Nothing is sent until
# MAIL_FROM and one of BREVO_API_KEY or SMTP_HOST are set.
# Brevo (HTTPS API, works where SMTP is blocked): an API key from brevo.com, and
# MAIL_FROM set to a sender you verified there.
# BREVO_API_KEY=xkeysib-...
# Or SMTP, used when BREVO_API_KEY isn't set. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, your address as SMTP_USERNAME
# and an app password (https://myaccount.google.com/apppasswords) as SMTP_PASSWORD.
# Check it works with: python -m app.services.mailer you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# MAIL_FROM=MoodForecast <you@gmail.com>
# Only for a local test server without TLS:
# SMTP_STARTTLS=false

# Public address of the site, used for the unsubscribe links in emails
PUBLIC_URL=http://localhost:8000

# Local hour (0-23) at each subscriber's location when the daily alert is sent; the app won't start with any other value
ALERT_HOUR=7
